{
  "name": "delhivery-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Delhivery B2C API",
  "keywords": ["delhivery", "shipping", "logistics", "sdk", "typescript"],
  "homepage": "https://delhivery-sdk.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/delhivery-sdk/delhivery-sdk.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
